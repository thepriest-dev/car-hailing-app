{
  "expo": {
    "name": "VeloCity",
    "slug": "velocity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "velocity",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.velocity.app",
      "config": {
        "googleMapsApiKey": "AIzaSyDs699Hr6WfepgE5PBov9r1SzC8ewlNzTA"
      }
    },
    "android": {
      "package": "com.velocity.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDs699Hr6WfepgE5PBov9r1SzC8ewlNzTA"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow VeloCity to use your location for rides",
          "locationWhenInUsePermission": "Allow VeloCity to use your location to find nearby drivers"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5fadca0-9aff-45f9-8288-1c225dc64d8e"
      }
    }
  }
}
